{
  "name": "@discord-mcbe/shared",
  "version": "0.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@minecraft/server": "catalog:",
    "@script-bridge/protocol": "catalog:"
  },
  "devDependencies": {
    "@discord-mcbe/internal-config": "workspace:*"
  }
}
