{
  "name": "@discord-mcbe/client",
  "version": "4.0.0-beta.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutinoko2048/discord-mcbe.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./bds": {
      "default": "./dist/bds.js",
      "types": "./dist/bds.d.ts"
    },
    "./local": {
      "default": "./dist/local.js",
      "types": "./dist/local.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "check": "vp check",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@discord-mcbe/shared": "workspace:*",
    "@minecraft/server": "catalog:",
    "@minecraft/server-ui": "catalog:",
    "@script-bridge/client": "catalog:",
    "@script-bridge/protocol": "catalog:"
  },
  "devDependencies": {
    "@bedrock-apis/env-types": "catalog:",
    "@discord-mcbe/internal-config": "workspace:*"
  }
}
