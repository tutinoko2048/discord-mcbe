{
  "name": "@discord-mcbe/server",
  "version": "3.1.3",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "start": "pnpm build --silent && node --enable-source-maps ./dist/main.js",
    "dev": "bun --watch ./src/main.ts",
    "build": "tsdown",
    "compile": "bun build --define __BUN_EXE__=true ./src/main.ts --compile --outfile=./build/discord-mcbe-server",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "bun ./tests/test.ts",
    "generate-schema": "bun ./scripts/generate-schema.ts",
    "generate-logo": "bun ./scripts/generate-logo.ts",
    "generate-lang-types": "bun ./scripts/generate-lang-types.ts"
  },
  "dependencies": {
    "@akki256/discord-interaction": "^3.1.1",
    "@discord-mcbe/shared": "workspace:*",
    "@minecraft/server": "catalog:",
    "@script-bridge/protocol": "catalog:",
    "@script-bridge/server": "catalog:",
    "colorette": "^2.0.20",
    "discord.js": "^14.25.1",
    "dotlang": "^1.1.1",
    "jsonc": "^2.0.0",
    "moment-timezone": "^0.5.48",
    "socket-be": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "oh-my-logo": "^0.2.1",
    "@discord-mcbe/internal-config": "workspace:*",
    "@types/bun": "^1.3.3",
    "zod-to-json-schema": "^3.25.0"
  }
}
