{
  "name": "@discord-mcbe/server",
  "version": "4.0.0-beta.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutinoko2048/discord-mcbe.git",
    "directory": "projects/server"
  },
  "files": [
    "dist",
    "schema.config.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "build:silent": "vp pack --log-level error",
    "watch": "vp pack --watch",
    "compile": "bun build --define __BUN_EXE__=true ./src/main.ts --compile --outfile=./build/discord-mcbe",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "check": "vp check",
    "clean": "rimraf dist build .turbo",
    "generate-schema": "bun ./scripts/generate-schema.ts",
    "generate-logo": "bun ./scripts/generate-logo.ts",
    "generate-lang-types": "bun ./scripts/generate-lang-types.ts",
    "extract-minecraft-lang": "bun ./scripts/extract-minecraft-lang.ts"
  },
  "dependencies": {
    "@akki256/discord-interaction": "^3.1.1",
    "@discord-mcbe/shared": "workspace:*",
    "@minecraft/server": "catalog:",
    "colorette": "^2.0.20",
    "discord.js": "^14.26.3",
    "dotlang": "^1.1.1",
    "jsonc": "^2.0.0",
    "moment-timezone": "^0.6.1",
    "socket-be": "^2.6.0",
    "ws": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@discord-mcbe/internal-config": "workspace:*",
    "@types/ws": "catalog:",
    "bun-types": "catalog:",
    "oh-my-logo": "^0.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
