{
  "extends": "@discord-mcbe/internal-config/typescript",
  "include": ["src"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",

    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "sourceMap": true,

    "allowJs": true,
    // "checkJs": true,
  }
}
