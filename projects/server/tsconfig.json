{
  "extends": "@discord-mcbe/internal-config/typescript",
  "include": ["src"],
  "compilerOptions": {
    "types": ["./src/global.d.ts"],
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",

    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "sourceMap": true,

    "allowJs": true,
    // "checkJs": true,
  },
  "references": [
    { "path": "../../packages/shared" }
  ]
}
