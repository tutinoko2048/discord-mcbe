{
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "description": "Language (File name in `lang` folder)"
        },
        "timezone_offset": {
          "type": "integer",
          "description": "Timezone used to display the time"
        },
        "scripts_entry": {
          "type": "string",
          "description": "The entry file for custom scripts"
        }
      },
      "additionalProperties": false
    },
    "bot": {
      "type": "object",
      "properties": {
        "command_role_id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Role ids that are allowed to use commands to minecraft"
        },
        "send_ready": {
          "type": "boolean",
          "description": "Whether to send messages when ready"
        },
        "strip_color_prefix": {
          "type": "boolean",
          "description": "Whether to delete § in messages sent from minecraft"
        },
        "panel_update_interval": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "The interval to update StatusPanel"
        }
      },
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "properties": {
        "disable_encryption": {
          "type": "boolean",
          "description": "Disable encryption for WebSocket connection"
        }
      },
      "additionalProperties": false
    },
    "debug": {
      "type": "boolean",
      "description": "debug."
    }
  },
  "required": [
    "app",
    "bot",
    "bridge"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}