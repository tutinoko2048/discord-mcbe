{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "language": {
          "description": "Language (File name in `lang` folder)",
          "type": "string"
        },
        "timezone_offset": {
          "description": "Timezone used to display the time",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "scripts_entry": {
          "description": "The entry file for custom scripts",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bot": {
      "type": "object",
      "properties": {
        "command_role_id": {
          "description": "Role ids that are allowed to use commands to minecraft",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "send_ready": {
          "description": "Whether to send messages when ready",
          "type": "boolean"
        },
        "strip_color_prefix": {
          "description": "Whether to delete § in messages sent from minecraft",
          "type": "boolean"
        },
        "panel_update_interval": {
          "description": "The interval to update StatusPanel",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "properties": {
        "disable_encryption": {
          "description": "Disable encryption for WebSocket connection",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "debug": {
      "description": "debug.",
      "type": "boolean"
    }
  },
  "required": [
    "app",
    "bot",
    "bridge"
  ],
  "additionalProperties": false
}