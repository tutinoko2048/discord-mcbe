{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The version of the config file, used for internal migration."
    },
    "language": {
      "type": "string",
      "enum": ["en-US", "ja"],
      "description": "Language"
    },
    "timezone_offset": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Timezone used to display the time"
    },
    "bot": {
      "type": "object",
      "properties": {
        "reply_preview_max_length": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum characters for replied content preview"
        },
        "strip_color_prefix": {
          "type": "boolean",
          "description": "Whether to delete § in messages sent from minecraft"
        },
        "minecraft_chat_avatar_url": {
          "description": "Optional avatar URL template for Minecraft chat webhooks. Supports {name} and {pfid}.",
          "type": "string"
        },
        "panel_update_interval": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The interval to update StatusPanel"
        },
        "discord_message_filter": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "on_fail": {
                      "type": "string",
                      "enum": ["cancel", "shorten"],
                      "description": "Action to take when content exceeds max length or lines"
                    },
                    "max_content_length": {
                      "description": "Maximum character length of the content",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "max_content_lines": {
                      "description": "Maximum number of lines in the content",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["on_fail"],
                  "additionalProperties": false,
                  "description": "LengthFilter"
                },
                {
                  "type": "object",
                  "properties": {
                    "on_fail": {
                      "type": "string",
                      "enum": ["cancel", "replace"],
                      "description": "Action to take when content matches the regex pattern"
                    },
                    "ignore_pattern": {
                      "type": "string",
                      "description": "Regular expression for content to ignore certain content"
                    }
                  },
                  "required": ["on_fail", "ignore_pattern"],
                  "additionalProperties": false,
                  "description": "RegexFilter"
                }
              ]
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "on_fail": {
                        "type": "string",
                        "enum": ["cancel", "shorten"],
                        "description": "Action to take when content exceeds max length or lines"
                      },
                      "max_content_length": {
                        "description": "Maximum character length of the content",
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max_content_lines": {
                        "description": "Maximum number of lines in the content",
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["on_fail"],
                    "additionalProperties": false,
                    "description": "LengthFilter"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "on_fail": {
                        "type": "string",
                        "enum": ["cancel", "replace"],
                        "description": "Action to take when content matches the regex pattern"
                      },
                      "ignore_pattern": {
                        "type": "string",
                        "description": "Regular expression for content to ignore certain content"
                      }
                    },
                    "required": ["on_fail", "ignore_pattern"],
                    "additionalProperties": false,
                    "description": "RegexFilter"
                  }
                ]
              }
            }
          ],
          "description": "Filters to apply to messages sent from Discord to Minecraft. Can be a single filter or an array of filters to apply in order."
        }
      },
      "required": [
        "reply_preview_max_length",
        "strip_color_prefix",
        "panel_update_interval",
        "discord_message_filter"
      ],
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "properties": {
        "disable_encryption": {
          "type": "boolean",
          "description": "Disable encryption for WebSocket connection"
        }
      },
      "required": ["disable_encryption"],
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "The entry file for custom scripts"
        }
      },
      "required": ["entry"],
      "additionalProperties": false
    },
    "translationOverrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "minecraft.connect",
          "minecraft.message",
          "minecraft.message.withAttachments",
          "minecraft.reply",
          "minecraft.reply.withAttachments",
          "discord.ready",
          "discord.connect",
          "discord.disconnect",
          "discord.chat",
          "discord.chat.multipleWorlds",
          "discord.join",
          "discord.leave",
          "discord.panel.uptime",
          "command.error.catch",
          "command.error.noworlds",
          "command.error.nopermission",
          "command.ping.description",
          "command.help.commands",
          "command.list.description",
          "command.list.silent.description",
          "command.list.world.description",
          "command.list.players",
          "command.panel.description",
          "command.panel.create.description",
          "command.panel.create.success",
          "command.panel.show.description",
          "command.panel.show.notFound",
          "command.command.description",
          "command.command.command.description",
          "command.command.raw.description",
          "command.command.silent.description",
          "command.command.world.description",
          "command.command.sending",
          "console.login",
          "console.socket.ready",
          "console.socket.command",
          "console.script.ready",
          "console.connect",
          "console.disconnect",
          "console.join",
          "console.leave",
          "console.message",
          "console.message.withAttachments",
          "console.reply",
          "console.reply.withAttachments",
          "console.command",
          "console.chat",
          "common.duration",
          "common.noOnlineWorlds",
          "common.worldNotFound"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Override specific translations with custom strings."
    },
    "debug": {
      "type": "boolean",
      "description": "debug."
    }
  },
  "required": [
    "config_version",
    "language",
    "timezone_offset",
    "bot",
    "bridge",
    "script",
    "translationOverrides",
    "debug"
  ],
  "additionalProperties": false
}
