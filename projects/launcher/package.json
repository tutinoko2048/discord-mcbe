{
  "name": "@discord-mcbe/launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts -c test --dry-run",
    "compile": "pnpm run clean && bun run compile.ts",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format ./src --write",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf build"
  },
  "dependencies": {
    "@inquirer/select": "^5.0.7",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@discord-mcbe/internal-config": "workspace:*",
    "@types/cli-progress": "^3.11.6",
    "bun-types": "^1.3.6"
  }
}
