{
  "name": "discord-mcbe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:silent": "turbo run build --output-logs errors-only",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "clean": "pnpm run -r clean",
    "bump-version": "bun run scripts/version.ts",
    "publish": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "rimraf": "^6.1.2",
    "tsdown": "^0.15.12",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.13"
  },
  "pnpm": {
    "overrides": {
      "@minecraft/server": "catalog:"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.28.0",
      "onFail": "error"
    }
  }
}
