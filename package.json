{
  "name": "discord-mcbe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:silent": "turbo run build --output-logs errors-only",
    "build:docs": "pnpm run -F @discord-mcbe/docs build",
    "build:reference": "typedoc",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "clean": "pnpm run -r clean",
    "bump-version": "bun run scripts/version.ts",
    "publish": "bun run scripts/publish.ts",
    "create-release-assets": "bun run scripts/create-release-assets.ts"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.9",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.18",
    "typedoc": "^0.28.19",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "pnpm": {
    "overrides": {
      "@minecraft/server": "catalog:"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.28.0",
      "onFail": "error"
    }
  }
}
