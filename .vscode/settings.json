{
  "json.schemas": [
    {
      "fileMatch": ["devapp/config.json", "projects/server/src/assets/config.json"],
      "url": "./projects/server/schema.config.json"
    }
  ],
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/dist": true,
    "**/build": true,
  },
  "oxc.fmt.configPath": "./packages/internal-config/vite/vite.config.base.mts",
}
